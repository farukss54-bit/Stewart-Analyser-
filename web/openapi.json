{
  "openapi": "3.1.0",
  "info": {
    "title": "Stewart Asit-Baz Analizi API",
    "version": "3.5.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "Sunucunun ayakta olduğunu bildirir.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/meta": {
      "get": {
        "summary": "Meta",
        "description": "Arayüzün ihtiyaç duyduğu sürüm, fizyolojik sınırlar ve referans aralıkları.\n\nDeğerlerin hepsi constants.py'den gelir; burada yeni eşik tanımlanmaz.",
        "operationId": "meta_api_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/derived": {
      "post": {
        "summary": "Derived",
        "description": "pH ve pCO2'den HCO3 ve BE'yi hesaplar; cihaz değerleri verilmişse tutarlılığı denetler.\n\nMantık, Streamlit arayüzündeki \"türetilmiş değerler\" bölümüyle aynıdır (BE işaret\nhatası denetimi dahil). Analizi engellemek arayüzün işidir; bu uç yalnızca bildirir.",
        "operationId": "derived_api_derived_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DerivedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DerivedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze": {
      "post": {
        "summary": "Analyze",
        "description": "Stewart analizini çalıştırır.\n\nGirdi doğrulamayı geçmezse 200 döner, is_valid=False olur ve hatalar listelenir\n(istek biçimi bozuksa FastAPI 422 verir).",
        "operationId": "analyze_api_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze/csv": {
      "post": {
        "summary": "Analyze Csv",
        "description": "Tek analizin sonucunu CSV olarak döndürür (başlık satırı + tek satır).\n\nSütunlar ve değerler Streamlit'teki \"Sonucu İndir (CSV)\" ile aynıdır: core.output_to_dict.\nGirdi doğrulamayı geçmezse indirilecek sonuç yoktur; 422 ve hata listesi döner.",
        "operationId": "analyze_csv_api_analyze_csv_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/batch": {
      "post": {
        "summary": "Batch",
        "description": "CSV metnindeki her satırı analiz eder (Streamlit'teki toplu analizle aynı yol).\n\nGeçersiz satır diğerlerini durdurmaz; satırın durumu ERROR olur ve nedeni yazılır.\nDosya okunamazsa ya da sınırı aşarsa 200 döner, is_valid=False olur.",
        "operationId": "batch_api_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases": {
      "get": {
        "summary": "Cases",
        "description": "Hazır (eğitim amaçlı) vakalar.",
        "operationId": "cases_api_cases_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Case"
                  },
                  "type": "array",
                  "title": "Response Cases Api Cases Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "ph": {
            "type": "number",
            "title": "Ph"
          },
          "pco2": {
            "type": "number",
            "title": "Pco2"
          },
          "na": {
            "type": "number",
            "title": "Na"
          },
          "cl": {
            "type": "number",
            "title": "Cl"
          },
          "hco3": {
            "anyOf": [
