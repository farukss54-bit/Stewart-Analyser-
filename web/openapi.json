          "ph",
          "pco2",
          "na",
          "cl"
        ],
        "title": "AnalyzeRequest",
        "description": "Analiz girdisi.\n\npH, pCO2, Na, Cl, K, Ca, Mg, laktat, albümin ve fosfatın aralık denetimi çekirdekteki\ndoğrulamada yapılır (is_valid=False döner). HCO3 ve BE'nin denetimi çekirdekte olmadığı\niçin istek modelinde yapılır (sınır dışı değer 422 verir)."
      },
      "AnalyzeResponse": {
        "properties": {
          "is_valid": {
            "type": "boolean",
            "title": "Is Valid"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errors"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StewartOutput"
              },
              {
                "type": "null"
              }
