                "minimum": 5.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Hco3"
          },
          "be": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 30.0,
                "minimum": -30.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Be"
          },
          "is_be_base_deficit": {
            "type": "boolean",
            "title": "Is Be Base Deficit",
            "default": false
          },
          "k": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "K"
          },
          "ca": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ca"
          },
          "mg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mg"
          },
          "lactate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lactate"
          },
          "po4": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Po4"
          },
          "albumin": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Albumin"
          },
          "albumin_unit": {
            "type": "string",
            "enum": [
              "g/L",
              "g/dL"
