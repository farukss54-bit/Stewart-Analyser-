        "required": [
          "is_valid",
          "errors",
          "warnings",
          "result"
        ],
        "title": "AnalyzeResponse",
        "description": "Doğrulama geçmezse is_valid=False olur ve result boş kalır."
      },
      "BatchRequest": {
